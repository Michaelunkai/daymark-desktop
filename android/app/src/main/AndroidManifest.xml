<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Voice + exact reminders: alarms must fire at the exact set time with
         an audible voice alert even when the app is closed (user law
         2026-10-27). USE_EXACT_ALARM is auto-granted (personal app). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Foreground reminder sync (user law 2026-10-27): reminders created on
         the PC must alert this phone even while the Daymark app is closed. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_daymark_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_daymark_launcher"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <meta-data
            android:name="com.michaelunkai.daymark.GIT_COMMIT"
            android:value="${daymarkGitCommit}" />
        <activity
            android:name="com.michaelunkai.daymark.MainActivity" android:label="Daymark"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="daymark" android:host="sync" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.michaelunkai.daymark.DiaryActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="Diary"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.michaelunkai.daymark.AiWorkspaceActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:label="AI Workspace"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="daymark" android:host="workspace" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="com.michaelunkai.daymark.AiWorkspaceLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_daymark_launcher"
            android:label="Daymark AI"
            android:roundIcon="@drawable/ic_daymark_launcher"
            android:targetActivity="com.michaelunkai.daymark.AiWorkspaceActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".ReminderDebugReceiver"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true" />
        <!-- Exact reminder alarms (user law 2026-10-27): these were the
             missing piece — the receiver classes existed but were never
             registered, so scheduled alarms never delivered. -->
        <receiver
            android:name="com.michaelunkai.daymark.ReminderAlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="com.michaelunkai.daymark.ReminderBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service
            android:name="com.michaelunkai.daymark.ReminderSyncService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="daymark-reminder-sync" />
        </service>
    </application>
</manifest>
