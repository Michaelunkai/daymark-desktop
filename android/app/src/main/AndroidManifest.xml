<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_daymark_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_daymark_launcher"
        android:resizeableActivity="true"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config">
        <meta-data
            android:name="com.michaelunkai.daymark.GIT_COMMIT"
            android:value="${daymarkGitCommit}" />
        <activity
            android:name="com.michaelunkai.daymark.MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="daymark" android:host="sync" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.michaelunkai.daymark.DiaryActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="false"
            android:label="Diary"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.michaelunkai.daymark.AiWorkspaceActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:label="AI Workspace"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="daymark" android:host="workspace" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name="com.michaelunkai.daymark.AiWorkspaceLauncher"
            android:enabled="true"
            android:exported="true"
            android:icon="@drawable/ic_daymark_launcher"
            android:label="Daymark AI"
            android:roundIcon="@drawable/ic_daymark_launcher"
            android:targetActivity="com.michaelunkai.daymark.AiWorkspaceActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".ReminderDebugReceiver"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true" />
        <!-- No receivers, services, or alarms: the companion app must have
             zero background execution. It runs only while on screen. -->
    </application>
</manifest>
